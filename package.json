{
  "name": "terminradar-nfz",
  "version": "0.1.0",
  "private": true,
  "description": "Fullstack TypeScript portfolio project for searching and monitoring public NFZ treatment queue data.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "check:repo": "turbo run lint test build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @terminradar/api dev",
    "dev:web": "pnpm --filter @terminradar/web dev",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "turbo": "^2.9.14"
  }
}
